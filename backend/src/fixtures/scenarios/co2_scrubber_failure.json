{
  "scenario_id": "SCENARIO_CO2_LEAK",
  "title": "Life Support Scrubber Failure (CO2 Buildup)",
  "category": "ENVIRONMENT",
  "severity": "CRITICAL",
  "description": "Life support CO2 absorption canisters saturate in Hab Module Alpha. CO2 rises from 0.38% to 1.30%, triggering cabin alerts and scrubber maintenance directives.",
  "duration_seconds": 90,
  "injects": [
    {
      "time_seconds": 0,
      "type": "CABIN_TELEMETRY",
      "target": "hab_module_alpha",
      "payload": { "co2_percent": 0.38, "o2_percent": 21.0, "cabin_pressure_kpa": 101.3, "temperature_c": 22.0, "humidity_percent": 45.0 }
    },
    {
      "time_seconds": 30,
      "type": "CABIN_TELEMETRY",
      "target": "hab_module_alpha",
      "payload": { "co2_percent": 0.68, "o2_percent": 20.6, "cabin_pressure_kpa": 101.2, "temperature_c": 22.3, "humidity_percent": 47.0 }
    },
    {
      "time_seconds": 60,
      "type": "CABIN_TELEMETRY",
      "target": "hab_module_alpha",
      "payload": { "co2_percent": 0.98, "o2_percent": 20.2, "cabin_pressure_kpa": 101.0, "temperature_c": 22.8, "humidity_percent": 50.0 }
    },
    {
      "time_seconds": 90,
      "type": "EVENT_ALERT",
      "target": "all_crew",
      "payload": { "title": "Scrubber Switchover Required", "severity": "critical", "message": "Secondary LiOH canister activation required immediately" }
    }
  ]
}
