# AstroCare Dual-Stack Environment Configuration
PROJECT_NAME="AstroCare v2 Backend"
ENVIRONMENT=development
DEBUG=true

# Service Ports
PORT=8000
NODE_PORT=8000
FASTAPI_PORT=8001
FRONTEND_PORT=3006
GATEWAY_PORT=80
MONGO_PORT=27018
POSTGRES_PORT=5433

# Database Connections
MONGODB_URI=mongodb://localhost:27018/astrocare
POSTGRES_HOST=localhost
POSTGRES_USER=astrocare
POSTGRES_PASSWORD=astrocare_dev_password
POSTGRES_DB=astrocare_db
DATABASE_URL=postgresql+asyncpg://astrocare:astrocare_dev_password@localhost:5433/astrocare_db

# Cross-Service Link
FASTAPI_URL=http://localhost:8001

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_astrocare_2026_min_32_bytes
FIELD_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
CORS_ORIGINS=http://localhost:3000,http://localhost:3006,http://localhost:8000,http://localhost:8001

# NASA & External Data Sources
NASA_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=astrocare-prototype@spaceapps.nasa.gov

# LLM Providers (F057)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
LLM_ORDER=groq,gemini,ollama
LLM_CONTEXT_TOKEN_BUDGET=4096

# Knowledge Base Embeddings (F056)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Sources & Operation Mode Flags (F141)
OFFLINE_MODE=false
SOURCES_ENABLED=noaa_swpc,donki,iss_live

# ML Fusion Model Settings (Model A & Model B)
ASTROCARE_STRESS_THRESHOLD=0.5
ASTROCARE_SESSION_TTL_HOURS=6
ASTROCARE_MAX_SESSIONS=1000
ASTROCARE_MODEL_URL=http://localhost:8001
